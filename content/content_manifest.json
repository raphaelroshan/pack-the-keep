  "events": [
    {
      "id": "commander_choice",
      "title": "Two Keys, One Keep",
      "type": "setup",
      "chapter": "chapter_1_open_the_armory",
      "locations": [
        "armory",
        "barracks"
      ],
      "trigger": "wave_index == 0",
      "setup": "The keep has two keys and two doctrines. One promises a connected defense; the other promises movement when the plan breaks.",
      "choices": [
        {
          "id": "choose_castellan",
          "label": "Give the keys to the Castellan.",
          "requirements": [],
          "effects": [
            "commander:castellan",
            "materials:+0",
            "morale:+0"
          ],
          "visible_result": "The keep becomes a problem of adjacency, layers, and disciplined space."
        },
        {
          "id": "choose_warden",
          "label": "Give the keys to the Warden.",
          "requirements": [],
          "effects": [
            "commander:warden",
            "materials:-4",
            "morale:+2"
          ],
          "visible_result": "The keep becomes a problem of movement, signals, and timely intervention."
        }
      ],
      "follow_up": "first_pack"
    },
    {
      "id": "first_forecast",
      "title": "The Bell Has a Pattern",
      "type": "forecast",
      "chapter": "chapter_2_first_bell",
      "locations": [
        "gate",
        "outer_wall",
        "north_tower"
      ],
      "trigger": "pieces >= 2 and wave_index == 0",
      "setup": "A scout returns with a simple warning: the first attackers are not hidden, but they are testing whether the gate is the only place the keep knows how to defend.",
      "choices": [
        {
          "id": "strengthen_gate",
          "label": "Concentrate the first line at the gate.",
          "requirements": [
            "owned_packs includes pike_line"
          ],
          "effects": [
            "doctrine_response:gate_assault",
            "gate_strength:+",
            "yard_flexibility:-"
          ],
          "visible_result": "The obvious answer becomes strong, but the inner yard must remain usable."
        },
        {
          "id": "keep_reserve",
          "label": "Leave a reserve in the inner yard.",
          "requirements": [
            "commander:warden or owned_packs includes scouts"
          ],
          "effects": [
            "response_time:+",
            "gate_strength:0",
            "mobile_reserve:+"
          ],
          "visible_result": "The first line is less impressive, but a bypass will not be free."
        },
        {
          "id": "signal_and_wait",
          "label": "Use the forecast to delay the bell and finish one support piece.",
          "requirements": [
            "owned_packs includes scouts",
            "command_points >= 1"
          ],
          "effects": [
            "command_points:-1",
            "support_piece:complete",
            "wave_timing:delayed"
          ],
          "visible_result": "Information buys a small amount of time, not a free defense."
        }
      ],
      "follow_up": "first_wave"
    },
    {
      "id": "partial_breach",
      "title": "The Wrong Wall",
      "type": "invasion",
      "chapter": "chapter_3_the_wrong_wall",
      "locations": [
        "outer_wall",
        "supply_room",
        "inner_yard"
      ],
      "trigger": "enemy_doctrine == distributed_sabotage and breach_level >= 1",
      "setup": "The wall did not fail where the player expected. A supply room brace is split, one route is blocked, and the keep still has enough strength for one clear repair choice.",
      "choices": [
        {
          "id": "repair_support",
          "label": "Repair the supply room and preserve recovery.",
          "requirements": [
            "owned_packs includes field_engineers",
            "materials >= 6"
          ],
          "effects": [
            "materials:-6",
            "supply_room:stable",
            "recovery:+"
          ],
          "visible_result": "The keep loses a little immediate strength but keeps its ability to recover."
        },
        {
          "id": "counterattack_gap",
          "label": "Move defenders through the yard and close the gap.",
          "requirements": [
            "commander == warden",
            "command_points >= 1"
          ],
          "effects": [
            "command_points:-1",
            "breach_pressure:-1",
            "yard:exposed"
          ],
          "visible_result": "The Warden turns movement into time, but the yard becomes the next pressure point."
        },
        {
          "id": "seal_the_room",
          "label": "Seal the damaged room and defend a smaller keep.",
          "requirements": [
            "commander == castellan",
            "materials >= 4"
          ],
          "effects": [
            "materials:-4",
            "room:supply_room:closed",
            "compact_bonus:+"
          ],
          "visible_result": "The perimeter shrinks, the interior becomes stronger, and nearby resources are lost."
        }
      ],
      "follow_up": "repair_phase"
    },
    {
      "id": "siege_beast_warning",
      "title": "Something Large at the Tree Line",
      "type": "campaign",
      "chapter": "chapter_4_the_refuge_bell",
      "locations": [
        "north_tower",
        "inner_yard",
        "old_chapel"
      ],
      "trigger": "wave_index >= 2 and enemy_doctrine == area_pressure",
      "setup": "The final warning is not a number. It is the sound of trees breaking beyond the old road. The beast will damage whatever the keep has made most important.",
      "choices": [
        {
          "id": "hold_compact",
          "label": "Lock the keep into a compact layered defense.",
          "requirements": [
            "commander == castellan",
            "owned_packs includes pike_line"
          ],
          "effects": [
            "ending:keep_holds",
            "compact_bonus:+",
            "outer_space:sacrificed"
          ],
          "visible_result": "The keep becomes harder to enter and less able to protect the ground outside it."
        },
        {
          "id": "open_response_lanes",
          "label": "Clear lanes for a mobile response.",
          "requirements": [
            "commander == warden",
            "owned_packs includes scouts"
          ],
          "effects": [
            "ending:refuge_survives",
            "yard_mobility:+",
            "materials:-8"
          ],
          "visible_result": "The keep gives up some construction strength to preserve movement and evacuation."
        },
        {
          "id": "ring_the_refuge_bell",
          "label": "Open the chapel as a refuge and prepare a controlled withdrawal.",
          "requirements": [
            "old_chapel_unlocked == true",
            "morale >= 5"
          ],
          "effects": [
            "ending:evacuation",
            "morale:-1",
            "civilian_safety:+"
          ],
          "visible_result": "The keep’s victory becomes measured by who reaches shelter, not only which walls remain."
        }
      ],
      "follow_up": "keep_report"
    }
  ],
