  "campaign": {
    "title": "The Bell at Dusk",
    "premise": "A small keep is granted one season to become a refuge before a coalition of raiders, sappers, climbers, and siege beasts tests every defensive doctrine at once.",
    "player_role": "A newly appointed keeper who must choose a commander, open coherent packs, and turn a neglected fort into a place that can survive pressure.",
    "regional_objective": "Hold the keep long enough to evacuate nearby households or prove that the keep can become their permanent refuge.",
    "invasion_force": "The Ashen Host is not one army but several practical pressures: raiders seek the gate, sappers seek weak structures, climbers seek walls that only look secure, and siege beasts punish static layouts.",
    "chapters": [
      {
        "id": "chapter_1_open_the_armory",
        "title": "Open the Armory",
        "summary": "Choose a commander, open the first pack, and make the keep readable before the first warning bell.",
        "entry_condition": "wave_index == 0",
        "exit_condition": "commander_selected and owned_packs >= 1 and pieces >= 2",
        "player_question": "What does this keep believe it is good at?",
        "beats": [
          "commander_choice",
          "first_pack",
          "room_inspection",
          "first_forecast"
        ]
      },
      {
        "id": "chapter_2_first_bell",
        "title": "The First Bell",
        "summary": "The first invasion teaches one doctrine cleanly enough that the player can identify the counter before the wave ends.",
        "entry_condition": "pieces >= 2",
        "exit_condition": "wave_1_resolved",
        "player_question": "Can my layout answer the threat I expected?",
        "beats": [
          "gate_assault_forecast",
          "first_wave",
          "pause_and_read",
          "first_repair"
        ]
      },
      {
        "id": "chapter_3_the_wrong_wall",
        "title": "The Wrong Wall",
        "summary": "A combined doctrine exposes a weakness that cannot be solved by placing more of the same piece.",
        "entry_condition": "wave_index >= 1",
        "exit_condition": "wave_2_resolved and breach_level >= 0",
        "player_question": "Which defensive idea failed, and what does the keep need instead?",
        "beats": [
          "pack_choice",
          "distributed_sabotage",
          "partial_breach",
          "repair_phase"
        ]
      },
      {
        "id": "chapter_4_the_refuge_bell",
        "title": "The Refuge Bell",
        "summary": "The final wave forces a choice between holding the keep intact, preserving people through a scarred defense, or abandoning the walls with a plan.",
        "entry_condition": "wave_index >= 2",
        "exit_condition": "campaign_outcome_selected",
        "player_question": "Is the keep a fortress, a refuge, or a tool for buying time?",
        "beats": [
          "siege_beast_warning",
          "final_pack",
          "last_intervention",
          "keep_report"
        ]
      }
    ]
  },
  "commanders": [
    {
      "id": "castellan",
      "name": "The Castellan",
      "public_doctrine": "A keep survives by making every room support the room beside it.",
      "passive": "Adjacent rooms reinforce one another.",
      "ability": "lockdown",
      "strength": "Compact layered defense and strong recovery when the interior remains connected.",
      "drawback": "Repositioning is slow, so exposed outer rooms are expensive to save.",
      "character_voice": "Measured, architectural, and protective of the keep as a place rather than a weapon.",
      "story_arc": [
        "inherits_a_keep_without_a_plan",
        "admits_compactness_can_become_a_trap",
        "chooses_people_over_the_perfect_layout"
      ],
      "favored_packs": [
        "pike_line",
        "field_engineers"
      ]
    },
    {
      "id": "warden",
      "name": "The Warden",
      "public_doctrine": "A defender who can move is worth more than a wall that cannot answer a new threat.",
      "passive": "Defenders reposition more quickly.",
      "ability": "rally",
      "strength": "Mobile response and strong recovery after a threat bypasses the first line.",
      "drawback": "The keep begins with fewer materials and needs exposed routes for rapid movement.",
      "character_voice": "Direct, impatient with static plans, and attentive to who is trapped behind the line.",
      "story_arc": [
        "arrives_with_a_mobile_doctrine",
        "learns_that_movement_needs_signal_and_space",
        "chooses_when_not_to_counterattack"
      ],
      "favored_packs": [
        "scouts",
        "firekeepers"
      ]
    }
  ],
  "packs": [
    {
      "id": "pike_line",
      "name": "Pike Line",
      "purpose": "Turn a narrow approach into a deliberate pressure point.",
      "pieces": [
        "pike_squad",
        "narrow_gate"
      ],
      "doctrine": "compact_corridors",
      "limitation": "Strong in corridors and weak when the enemy spreads across open yard.",
      "choice_text": "Spend space to make one approach exceptionally readable."
    },
    {
      "id": "field_engineers",
      "name": "Field Engineers",
      "purpose": "Make the keep recoverable after a structure is damaged.",
      "pieces": [
        "repair_station",
        "brace"
      ],
      "doctrine": "redundancy",
      "limitation": "Consumes materials and creates a high-value support target.",
      "choice_text": "Spend immediate strength on the ability to survive a later mistake."
    },
    {
      "id": "firekeepers",
      "name": "Firekeepers",
      "purpose": "Deny open space and punish a predictable approach.",
      "pieces": [
        "fire_team",
        "fire_brazier"
      ],
      "doctrine": "denial_zones",
      "limitation": "Needs clear sightlines and can create unsafe movement lanes for friendly defenders.",
      "choice_text": "Shape the battlefield rather than simply add another body."
    },
    {
      "id": "scouts",
      "name": "Scouts",
      "purpose": "Reveal the invasion’s approach and improve response time.",
      "pieces": [
        "scout_post",
        "signal_beacon"
      ],
      "doctrine": "early_warning",
      "limitation": "Information does not stop a breach unless the keep can act on it.",
      "choice_text": "Spend a pack on knowing where the next problem will be."
    },
    {
      "id": "runner_network",
      "name": "Runner Network",
      "purpose": "Make open layouts and rapid relief viable.",
      "pieces": ["runner_pair", "supply_cache"],
      "doctrine": "rapid_redeployment",
      "limitation": "Fragile pieces lose value when lanes close or support is exposed.",
      "choice_text": "Spend space on movement and a reserve instead of immediate stopping power."
    },
    {
      "id": "fallback_convoy",
      "name": "Fallback Convoy",
      "purpose": "Hold a second line and spend one structure to save another.",
      "pieces": ["rear_guard", "breakaway_barricade"],
      "doctrine": "controlled_fallback",
      "limitation": "Provides less value before contact and consumes precious reserve space.",
      "choice_text": "Reserve space and condition now so the keep can yield without collapsing."
    },
    {
      "id": "crossbow_watch",
      "name": "Crossbow Watch",
      "purpose": "Pierce armored pressure from an elevated firing line.",
      "pieces": ["crossbow_patrol", "watch_banner"],
      "doctrine": "layered_crossfire",
      "limitation": "Upper-wall placement and finite ammunition make the firing line powerful but inflexible.",
      "choice_text": "Spend wall space on a precise answer to armored advances."
    },
    {
      "id": "bell_guard",
      "name": "Bell Guard",
      "purpose": "Preserve warning and response timing through disrupted sightlines.",
      "pieces": ["bellkeepers", "signal_beacon"],
      "doctrine": "coordinated_response",
      "limitation": "Both pieces are non-attacking and the link fails across floors or beyond range.",
      "choice_text": "Spend support positions on a warning chain that keeps the forecast trustworthy."
    },
    {
      "id": "shieldwall",
      "name": "Shieldwall",
      "purpose": "Build one resilient anchor and understand when protection will be bypassed.",
      "pieces": ["shield_wardens", "emergency_shutters"],
      "doctrine": "anchored_gates",
      "limitation": "Static protection cannot stop a Shieldbreaker and leaves separated routes exposed.",
      "choice_text": "Protect one line while retaining a direct answer or secondary defense."
    }
  ],
