; Engine configuration file.
; Pack the Keep — agent-first Godot prototype
; Godot 4.x

config_version=5

[application]
config/name="Pack the Keep"
config/version="0.51.0-early-access-candidate"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.045, 0.04, 0.055, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[input]

battle_advance={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194309,"unicode":13)]}
battle_pause={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32,"unicode":32), Object(InputEventKey,"physical_keycode":80,"unicode":112), Object(InputEventJoypadButton,"button_index":6)]}
battle_speed_half={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":49,"unicode":49)]}
battle_speed_normal={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":50,"unicode":50)]}
battle_speed_double={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":51,"unicode":51)]}
battle_manual_step={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":78,"unicode":110), Object(InputEventJoypadButton,"button_index":2)]}
commander_ability={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":81,"unicode":113), Object(InputEventJoypadButton,"button_index":3)]}
placement_arm={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":82,"unicode":114), Object(InputEventJoypadButton,"button_index":10)]}
placement_cancel={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]}
report_focus={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":70,"unicode":102), Object(InputEventJoypadButton,"button_index":7)]}
feedback_mute={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":77,"unicode":109)]}
contrast_toggle={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":67,"unicode":99)]}
reduced_motion_toggle={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":86,"unicode":118)]}
focus_cycle_forward={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194308), Object(InputEventJoypadButton,"button_index":9)]}
focus_cycle_backward={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194308,"shift_pressed":true)]}
focus_enemy={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":69,"unicode":101), Object(InputEventJoypadButton,"button_index":8)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045, 0.04, 0.055, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
